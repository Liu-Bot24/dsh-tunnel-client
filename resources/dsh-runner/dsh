#!/bin/sh

set -eu

if command -v npx >/dev/null 2>&1; then
  NPX_BIN="$(command -v npx)"
elif [ -x /opt/homebrew/bin/npx ]; then
  NPX_BIN=/opt/homebrew/bin/npx
elif [ -x /usr/local/bin/npx ]; then
  NPX_BIN=/usr/local/bin/npx
else
  echo "未找到 npx，请先安装 Node.js。" >&2
  exit 127
fi

case "$NPX_BIN" in
  */*) NPX_DIR="${NPX_BIN%/*}" ;;
  *) NPX_DIR=. ;;
esac
if [ -x "$NPX_DIR/node" ]; then
  exec "$NPX_DIR/node" "$NPX_BIN" --yes @deepseek-ai/dsh "$@"
fi

PATH="$NPX_DIR${PATH:+:$PATH}"
export PATH
exec "$NPX_BIN" --yes @deepseek-ai/dsh "$@"
